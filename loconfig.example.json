{
  "locust": {
    "locustfile": "tests/locustfile.py",
    "host": "http://localhost:8080",
    "users": 50,
    "spawn_rate": 5,
    "run_time": "1m",
    "tags": [],
    "exclude_tags": [],
    "extra_args": []
  },
  "artifacts": {
    "storage": "artifacts"
  },
  "analysis": {
    "mode": "resilience",
    "gate": {
      "min_requests": 100,
      "thresholds": {
        "error_rate": {
          "fail": 5
        }
      }
    },
    "rules_file": "rules.json",
    "fail_on": "DEGRADATION"
  },
  "report": {
    "title": "CI Load Test Report",
    "output": "artifacts/report.html"
  }
}
